#!/usr/bin/python3 -I
"""systemmonitor-fan – styrer vifter for Systemmonitor. Kjøres som root via sudo.

Godtar KUN disse kommandoene:
  pwm <brikke> <kanal 1-7> <prosent 0-100 | auto>   hovedkortvifte (nct67xx)
  gpu <prosent 0-100 | auto>                        alle NVIDIA-vifter
  all-auto                                          alle vifter tilbake til automatikk

Sikkerhet: hovedkortvifter settes aldri under 20 %, NVIDIA aldri under kortets minimum.
"""
import ctypes
import glob
import os
import re
import sys

BOARD_MIN = 20
STATE_DIR = "/run/systemmonitor-fan"   # husker opprinnelig automodus til neste omstart


def die(msg, code=2):
    print(msg, file=sys.stderr)
    sys.exit(code)


def parse_pct(v):
    if v == "auto":
        return "auto"
    if not re.fullmatch(r"\d{1,3}", v) or int(v) > 100:
        die(f"ugyldig prosent: {v}")
    return int(v)


def find_chip(name):
    if not re.fullmatch(r"nct6\d{3}[a-z]?", name):
        die(f"ugyldig brikke: {name}")
    for h in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            if open(os.path.join(h, "name")).read().strip() == name:
                return h
        except OSError:
            pass
    die(f"fant ikke {name}", 1)


def write(path, value):
    with open(path, "w") as f:
        f.write(str(value))


def set_pwm(chip, ch, pct):
    if not re.fullmatch(r"[1-7]", ch):
        die(f"ugyldig kanal: {ch}")
    h = find_chip(chip)
    pwm = os.path.join(h, f"pwm{ch}")
    enable = pwm + "_enable"
    if not os.path.exists(pwm) or not os.path.exists(enable):
        die(f"{chip} har ikke pwm{ch}", 1)
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    saved = os.path.join(STATE_DIR, f"{chip}-pwm{ch}.enable")
    if pct == "auto":
        orig = open(saved).read().strip() if os.path.exists(saved) else "5"
        write(enable, orig if orig not in ("0", "1") else "5")
        return
    if not os.path.exists(saved):
        cur = open(enable).read().strip()
        if cur != "1":                     # lagre BIOS-automodus første gang
            write(saved, cur)
    write(enable, 1)
    write(pwm, round(max(pct, BOARD_MIN) * 255 / 100))


def nvml():
    try:
        n = ctypes.CDLL("libnvidia-ml.so.1")
    except OSError:
        return None
    if n.nvmlInit_v2() != 0:
        return None
    return n


def set_gpu(pct):
    n = nvml()
    if not n:
        die("NVIDIA-driver ikke tilgjengelig", 1)
    try:
        cnt = ctypes.c_uint()
        n.nvmlDeviceGetCount_v2(ctypes.byref(cnt))
        for i in range(cnt.value):
            h = ctypes.c_void_p()
            if n.nvmlDeviceGetHandleByIndex_v2(i, ctypes.byref(h)) != 0:
                continue
            fans = ctypes.c_uint()
            if n.nvmlDeviceGetNumFans(h, ctypes.byref(fans)) != 0:
                continue
            lo, hi = ctypes.c_uint(30), ctypes.c_uint(100)
            n.nvmlDeviceGetMinMaxFanSpeed(h, ctypes.byref(lo), ctypes.byref(hi))
            for f in range(fans.value):
                if pct == "auto":
                    r = n.nvmlDeviceSetDefaultFanSpeed_v2(h, f)
                else:
                    r = n.nvmlDeviceSetFanSpeed_v2(h, f, min(max(pct, lo.value), hi.value))
                if r != 0:
                    die(f"NVML-feil {r} på GPU {i} vifte {f}", 1)
    finally:
        n.nvmlShutdown()


def all_auto():
    for h in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            name = open(os.path.join(h, "name")).read().strip()
        except OSError:
            continue
        if re.fullmatch(r"nct6\d{3}[a-z]?", name):
            for p in glob.glob(os.path.join(h, "pwm[1-7]_enable")):
                ch = re.search(r"pwm(\d)_enable", p).group(1)
                saved = os.path.join(STATE_DIR, f"{name}-pwm{ch}.enable")
                if open(p).read().strip() == "1" or os.path.exists(saved):
                    set_pwm(name, ch, "auto")
    if nvml():
        set_gpu("auto")


def main(a):
    if a[:1] == ["pwm"] and len(a) == 4:
        set_pwm(a[1], a[2], parse_pct(a[3]))
    elif a[:1] == ["gpu"] and len(a) == 2:
        set_gpu(parse_pct(a[1]))
    elif a == ["all-auto"]:
        all_auto()
    else:
        die(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
