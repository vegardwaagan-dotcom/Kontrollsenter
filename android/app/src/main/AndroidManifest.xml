<?xml version="1.0" encoding="utf-8"?>
<!-- Kontrollsenter for Android – styr PC-ene med Kontrollsenter fra mobil og nettbrett (hjemmenettet). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- oppdatering av appen fra NAS-en (via PC-en), og varsel når en ny versjon er klar -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- for å se om Moonlight og RustDesk er installert, og åpne dem -->
    <queries>
        <package android:name="com.limelight" />
        <package android:name="com.carriez.flutter_hbb" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Kontrollsenter"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:resizeableActivity="true"
        android:supportsRtl="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- «Del» fra andre apper: send lenke/tekst til PC-en -->
            <intent-filter android:label="Send til PC-en">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <receiver android:name=".StatusWidget" android:exported="false" android:label="Kontrollsenter">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
        <provider android:name=".ShareProvider" android:authorities="no.waagan.kontrollsenter.share"
            android:exported="false" android:grantUriPermissions="true" />
        <receiver android:name=".GameWidget" android:exported="false" android:label="Spillstatus">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_game_info" />
        </receiver>
        <receiver android:name=".TempWidget" android:exported="false" android:label="Temperaturer">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_temp_info" />
        </receiver>
        <receiver android:name=".QuickWidget" android:exported="false" android:label="Hurtigknapper">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick_info" />
        </receiver>
        <receiver android:name=".ChatReply" android:exported="false" />
        <receiver android:name=".ChatWidget" android:exported="false" android:label="Chat">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_chat_info" />
        </receiver>
        <receiver android:name=".FamilyWidget" android:exported="false" android:label="Familien">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_family_info" />
        </receiver>
        <receiver android:name=".BatteryWidget" android:exported="false" android:label="Batterier">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_battery_info" />
        </receiver>
        <receiver android:name=".PlaytimeWidget" android:exported="false" android:label="Spilletid i dag">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_playtime_info" />
        </receiver>
        <service android:name=".PowerTile" android:label="Strømmodus" android:exported="true"
            android:icon="@android:drawable/ic_lock_power_off"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service android:name=".ClipTile" android:label="Lagre klipp" android:exported="true"
            android:icon="@android:drawable/ic_menu_camera"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service android:name=".GameModeTile" android:label="Spillmodus" android:exported="true"
            android:icon="@android:drawable/ic_media_play"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <receiver android:name=".PickWidget" android:exported="false" android:label="Velg selv">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_pick_info" />
        </receiver>
        <activity android:name=".PickConfig" android:exported="true" android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity android:name=".QuickAction" android:exported="true" android:excludeFromRecents="true"
            android:taskAffinity="" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service android:name=".MuteTile" android:label="Demp PC-en" android:exported="true"
            android:icon="@android:drawable/ic_lock_silent_mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service android:name=".DinnerTile" android:label="Middag!" android:exported="true"
            android:icon="@android:drawable/ic_dialog_email"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service android:name=".LiveService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service
            android:name=".UpdateJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
    </application>
</manifest>
