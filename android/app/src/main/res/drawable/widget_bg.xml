<?xml version="1.0" encoding="utf-8"?>
<!-- glassbakgrunn: mørk nattblå med blått og lilla skjær og lys kant -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient android:angle="315" android:startColor="#D92A3A78" android:centerColor="#E6121424" android:endColor="#D9402A7A" />
        </shape>
    </item>
    <item android:bottom="40dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="26dp" android:topRightRadius="26dp" />
            <gradient android:angle="270" android:startColor="#22FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
