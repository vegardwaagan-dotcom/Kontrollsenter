<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Chat" android:textAllCaps="true" android:letterSpacing="0.12" android:textColor="#99FFFFFF"
        android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/c1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="5dp" />
    <TextView android:id="@+id/c2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#CCFFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" android:visibility="gone" />
    <TextView android:id="@+id/c3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#99FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="10dp">
        <TextView android:id="@+id/w_q1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
            android:gravity="center" android:text="Kommer! 🏃" android:textColor="#FFFFFF" android:textSize="14sp"
            android:textStyle="bold" android:background="@drawable/widget_btn" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/w_q2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
            android:gravity="center" android:text="5 min til ⏳" android:textColor="#FFFFFF" android:textSize="14sp"
            android:textStyle="bold" android:background="@drawable/widget_btn" />
    </LinearLayout>
    <TextView android:id="@+id/w_err" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:textColor="#B3FFFFFF" android:textSize="13sp" android:layout_marginTop="6dp" />
</LinearLayout>
