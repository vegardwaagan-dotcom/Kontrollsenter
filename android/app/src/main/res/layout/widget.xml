<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#E61E1E24">
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Kontrollsenter" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_line1" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Henter …" android:textColor="#FFFFFF" android:textSize="20sp" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/w_line2" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#B0B0BC" android:textSize="13sp" android:layout_marginTop="2dp" />
</LinearLayout>
