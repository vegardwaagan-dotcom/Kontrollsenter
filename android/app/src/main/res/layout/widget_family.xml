<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Familien" android:textAllCaps="true" android:letterSpacing="0.12" android:textColor="#99FFFFFF"
        android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/f1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="5dp" android:visibility="gone" />
    <TextView android:id="@+id/f2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="5dp" android:visibility="gone" />
    <TextView android:id="@+id/f3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="5dp" android:visibility="gone" />
    <TextView android:id="@+id/f4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="5dp" android:visibility="gone" />
    <TextView android:id="@+id/f5" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="5dp" android:visibility="gone" />
    <TextView android:id="@+id/w_dinner" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp"
        android:gravity="center" android:text="🍽️  Middag!" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
        android:background="@drawable/widget_btn" />
    <TextView android:id="@+id/w_err" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:textColor="#B3FFFFFF" android:textSize="13sp" android:layout_marginTop="6dp" />
</LinearLayout>
